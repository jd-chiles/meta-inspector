{
  "name": "habitability-walkthrough-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first LAHSA Form 1083 walkthrough companion for room video capture, evidence-linked draft review, worker sign-off, and local exports. Video decoding runs in the browser; live Meta SAM and Muse processing stays server-side and is never required for local checks.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && npx --no-install playwright test",
    "test:live": "node tests/live/smoke.mjs"
  },
  "dependencies": {
    "@next/env": "15.1.6",
    "@fontsource/unifont": "^5.3.0",
    "@meta-sam/parser": "^0.1.0",
    "@meta-sam/video": "^0.1.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "idb": "8.0.0",
    "lucide-react": "^1.64.0",
    "mediabunny": "1.63.0",
    "next": "15.1.6",
    "pdf-lib": "^1.17.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.1.0",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.6",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "overrides": {
    "mediabunny": "1.63.0"
  }
}
