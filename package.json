{
  "name": "habitability-walkthrough-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first LAHSA Form 1083 walkthrough companion with thin browser capture/review, private cloud storage, durable server-side video processing, cloud workflow state, and server-generated exports.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && npx --no-install playwright test",
    "db:migrate": "node scripts/migrate-cloud-db.mjs",
    "test:live": "node tests/live/cloud-job-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/unifont": "^5.3.0",
    "@langfuse/client": "^6.1.1",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@meta-sam/parser": "^0.1.0",
    "@meta-sam/video": "^0.1.5",
    "@next/env": "15.1.6",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "idb": "8.0.0",
    "lucide-react": "^1.64.0",
    "mediabunny": "1.63.0",
    "next": "15.1.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.1.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.6",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "overrides": {
    "mediabunny": "1.63.0"
  }
}
