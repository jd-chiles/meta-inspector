# Names only. Never commit values. Server-only keys; no NEXT_PUBLIC_* secrets.
# Maps to the official MODEL_API_KEY bearer token (see docs/integration/FORM_1083_MAPPING.md).
META_API_KEY=
# Fallback alias for the official MODEL_API_KEY bearer token (read at src/server/meta/adapter.ts:125).
MODEL_API_KEY=
# Default: muse-spark-1.3 (Standard mode). Contributor variants must not be used for pilot data.
META_MODEL=
# Must stay on the allowlist: https://api.meta.ai/v1
META_API_BASE_URL=
# Optional Muse Spark Open fallback for mapping when the Meta Muse endpoint is unavailable.
# The API host and model are fixed in server code; this key is never read by the browser.
BASETEN_API_KEY=
# Absolute path to the FFmpeg 9.0.2 binary built by scripts/install-ffmpeg-runtime.sh.
# Required on the Node server for live video frame verification; never used by the phone.
FFMPEG_PATH=
# live|fixture. Fixture is the safe default for local/CI without credentials.
APP_ANALYSIS_MODE=
# Simultaneous SAM concept calls per segment request (server-only, optional).
# Parsed int, clamped 1-6, default 6. Safe when unset.
SAM_MAX_CONCURRENT_CONCEPTS=
# Set only when a trusted reverse proxy serves the app on a different public origin.
# Example: https://your-tailnet-host.ts.net:3100
APP_PUBLIC_ORIGIN=
# Shared pilot passcode for the in-app access gate (server-only). When set,
# every page and API route requires the unlock cookie; when unset (local/CI),
# the app is ungated.
INSPECTION_PASSCODE=
# Fish Audio voice loop (server-only). Without a key + voice id, spoken
# prompts fall back to the device voice and answers stay tap-only.
FISH_API_KEY=
FISH_VOICE_ID=
# Spanish guided-tour owner voice (server-only, REQ-R2). When unset, the
# Español toggle is disabled with an honest note; nothing else changes.
FISH_VOICE_ID_ES=
# Optional model overrides. Defaults: s2.1-pro-free (TTS), transcribe-1-pro (ASR).
FISH_MODEL=
FISH_ASR_MODEL=
# Voice-transcript engine (server-only, optional). muse|fish, default muse.
# Muse failures fall back to Fish once and the client says so. Safe when unset.
VOICE_ASR_PROVIDER=
# Muse Voice Transcribe model override. Default: muse-voice-transcribe-1.0.
META_TRANSCRIBE_MODEL=
# Case-note AI wording polish (server-only, optional). Only the exact value
# 1 enables the polish route; anything else (including unset) returns the
# deterministic template with no provider call.
TEXT_POLISH_ENABLED=
# Langfuse pipeline tracing + eval datasets (server-only, optional, REQ-O1/O2).
# Tracing runs only when BOTH keys are set; unset means zero overhead and no
# network calls. Traces carry debugging metadata only — never media bytes,
# pseudonyms, names, or keys. Base URL defaults to https://cloud.langfuse.com.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=
# Either base-URL spelling works (LANGFUSE_BASEURL wins when both are set).
LANGFUSE_BASE_URL=
# Trace environment override (lowercase letters/digits/_/-). When unset, the
# production app origin maps to production and everything else to development.
LANGFUSE_ENVIRONMENT=
