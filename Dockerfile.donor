# Local-only build variant: ffmpeg.org is unreachable, so reuse the verified
# /opt/ffmpeg 9.0.2 tree from the local mvp31 image instead of compiling.
# Not part of the shipped tree; production Dockerfile is unchanged.
FROM metainspectprod.azurecr.io/metainspect:mvp31 AS ffmpeg

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
ENV FFMPEG_PATH=/opt/ffmpeg/bin/ffmpeg
RUN addgroup -S app && adduser -S app -G app
COPY --from=ffmpeg /opt/ffmpeg /opt/ffmpeg
COPY --from=build --chown=app:app /app/.next/standalone ./
COPY --from=build --chown=app:app /app/.next/static ./.next/static
COPY --from=build --chown=app:app /app/public ./public
USER app
EXPOSE 3000
CMD ["node", "server.js"]
